# syntax=docker/dockerfile:1.5

# Docker-in-Docker variant: the mise devcontainer image plus a docker daemon.
# Runtime requires a privileged container (or at least SYS_ADMIN + NET_ADMIN).
# Build arg is the full base image reference, e.g.
#   mietzen/mise-devcontainer:0.1.0-mise-v2026.8.3-uv-0.12.3-amd64
ARG MISE_DEVCONTAINER_IMAGE

FROM ${MISE_DEVCONTAINER_IMAGE}

# dockerd must run as root; the vscode user talks to the socket via the docker
# group instead of sudo (the base image's sudo is scoped to chown only).
USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        docker.io docker-cli docker-compose; \
    rm -rf /var/lib/apt/lists/*; \
    usermod -aG docker vscode;

# Start dockerd on container start, then hand off to the container command.
COPY docker-init.sh /usr/local/share/docker-init.sh
RUN chmod +x /usr/local/share/docker-init.sh

USER root
ENTRYPOINT ["/usr/local/share/docker-init.sh"]
CMD ["/usr/bin/zsh"]
